{
  "name": "acm-tree",
  "private": true,
  "type": "module",
  "_comment_python": "★ 所有 python 调用都带 `-X utf8`（2026-10-18）：Python 的 stdio 默认按『系统 ANSI 代码页』编码，关掉 Windows 的『UTF-8 Beta』后它变 936(GBK)，而 GBK 里没有 ✅❌⚠️✔✘⟨⟩ 这些字符 ⇒ 打第一行符号就 UnicodeEncodeError。`-X utf8` = 进程内 UTF-8 模式（stdio 与 open() 默认编码都变 UTF-8），**不依赖任何机器设置**。守卫：src/test/buildEntryPoints.test.js。",
  "scripts": {
    "test": "node app/scripts/run-tests.mjs",
    "test:smoke": "node app/scripts/run-smoke.mjs",
    "test:all": "npm test && npm run test:smoke",
    "measure:layout": "node app/scripts/measure-layout.mjs",
    "test:native": "node --test",
    "crate:check": "node app/scripts/crate-check.mjs",
    "crate:selftest": "python -X utf8 app/scripts/crate.py selftest",
    "crate:sample:qoj": "python -X utf8 app/acm-data/scripts/qoj_adapter.py problems app/acm-data/raw/qoj_problems.json -o app/acm-data/merged/sample_qoj_crate.json",
    "crate:hdu": "python -X utf8 \"app/acm-data/raw/Scaper/02 hdu/hdu_multi_fetch.py\" build",
    "crate:hdu:fetch": "python -X utf8 \"app/acm-data/raw/Scaper/02 hdu/hdu_multi_fetch.py\" fetch",
    "crate:hdu:browser": "python -X utf8 \"app/acm-data/raw/Scaper/02 hdu/hdu_pipeline.py\" --all",
    "crate:hdu:keep": "python -X utf8 \"app/acm-data/raw/Scaper/02 hdu/hdu_pipeline.py\" --all --keep-source",
    "crate:nk": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/nk_multi_fetch.py\" build --from-year 2023",
    "crate:nk:browser": "python -X utf8 \"app/acm-data/raw/Scaper/01 nk/nk_pipeline.py\" --all",
    "crate:nk:keep": "python -X utf8 \"app/acm-data/raw/Scaper/01 nk/nk_pipeline.py\" --all --keep-source",
    "crate:xcpc": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/xcpc_pipeline.py\"",
    "crate:xcpc:all": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/xcpc_pipeline.py\" --force --all-nodes",
    "crate:all": "python -X utf8 -B app/scripts/build-all.py",
    "crate:all:offline": "python -X utf8 -B app/scripts/build-all.py --offline",
    "crate:all:list": "python -X utf8 -B app/scripts/build-all.py --list",
    "crate:xcpc:qoj": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/xcpc_pipeline.py\" --only-source qoj",
    "crate:xcpc:tree": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/fetch_rankland_tree.py\"",
    "crate:xcpc:selftest": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/selftest.py\"",
    "crate:xcpc:sources": "python -X utf8 \"app/acm-data/raw/Scaper/05 xcpc/source_report.py\"",
    "crate:merge": "node app/scripts/crate-merge.mjs",
    "prune:raw": "python -X utf8 -B app/scripts/prune-raw.py",
    "prune:raw:apply": "python -X utf8 -B app/scripts/prune-raw.py --apply",
    "crate:baseline": "python -X utf8 -B app/scripts/nature-baseline.py apply --baseline app/acm-data/nature-assignments.json app/acm-data/nodes/all_nodes.json",
    "crate:baseline:report": "python -X utf8 -B app/scripts/nature-baseline.py report --baseline app/acm-data/nature-assignments.json app/acm-data/nodes/all_nodes.json",
    "crate:baseline:selftest": "python -X utf8 -B app/scripts/nature-baseline.py selftest"
  }
}
